# --- Backend ---
DATABASE_URL=postgresql+psycopg://inframanager:inframanager@localhost:5432/inframanager
SECRET_KEY=change-me-generate-a-long-random-string
ENCRYPTION_KEY=

# Seed admin (created by `python -m app.seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5180,http://localhost:3000

# Proxmox (credentials never sent to the frontend)
PROXMOX_URL=https://192.168.10.90:8006
PROXMOX_TOKEN_ID=root@pam!inframanager
PROXMOX_TOKEN_SECRET=
PROXMOX_TLS_VERIFY=true
PROXMOX_SYNC_SECONDS=30

# Veeam (leave empty until a server is registered)
VEEAM_API_URL=
VEEAM_USERNAME=
VEEAM_PASSWORD=
VEEAM_SYNC_SECONDS=300

# Alert thresholds (configurable, not hardcoded)
STORAGE_WARNING_THRESHOLD=80
STORAGE_CRITICAL_THRESHOLD=90
STORAGE_FULL_THRESHOLD=95
